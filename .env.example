# ========= PaperRAG .env (copy to .env before running) =========

# ----- MySQL -----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=paperrag
# SQLAlchemy URL override (optional; auto-built from above if empty)
MYSQL_URL=

# ----- Qdrant -----
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=paperrag
QDRANT_API_KEY=
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# ----- Cloud LLM (MiniMax official API) -----
LLM_MODEL=MiniMax-M2.7
LLM_API_BASE=https://api.minimax.chat/v1
LLM_API_KEY=

# ----- Cloud Embedding (SiliconFlow OpenAI-compatible API) -----
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=

# ----- Ingest / RAG -----
CHUNK_SIZE=800
CHUNK_OVERLAP=100
CHUNK_MIN_CHARS=80
CHUNK_NOISE_SYMBOL_RATIO=0.35
CHUNK_DROP_REFERENCES=false
RETRIEVAL_K=20
FINAL_CONTEXT_K=5

# Chat history (number of recent messages to include as context)
CHAT_HISTORY_WINDOW=10

# Hybrid retrieval (vector oversample + BM25 fusion)
HYBRID_RETRIEVAL_ENABLED=true
HYBRID_OVERSAMPLE=4
HYBRID_ALPHA=0.5
HYBRID_MAX_FETCH=96

# Caches (retrieval TTL + query embedding LRU)
CACHE_RETRIEVAL_ENABLED=true
CACHE_RETRIEVAL_TTL_SEC=180
CACHE_RETRIEVAL_MAX_ENTRIES=256
CACHE_EMBEDDING_ENABLED=true
CACHE_EMBEDDING_MAX_ENTRIES=512

# HTTP retry (embedding API)
HTTP_RETRY_MAX_ATTEMPTS=4
HTTP_RETRY_BACKOFF_BASE_SEC=0.45

# LLM client retries (LangChain / OpenAI-compatible)
LLM_MAX_RETRIES=2

# ----- Agent -----
AGENT_MAX_PLAN_STEPS=7
AGENT_MAX_REFLECTIONS=2
# full_agentic = preserve the complete planner path (safe default);
# auto = opt in to the fast path only after frozen-eval acceptance.
AGENT_ROUTING_MODE=full_agentic
AGENT_EXTERNAL_RETRIEVAL_ENABLED=true
AGENT_CHECKPOINT_ENABLED=true
AGENT_CHECKPOINT_PATH=./data/langgraph_checkpoints.sqlite

# Web Search (Tavily - optional)
TAVILY_API_KEY=

# arXiv
ARXIV_MAX_RESULTS=5

# Optional: separate models for agent nodes (defaults to LLM_MODEL)
PLANNER_MODEL=
REFLECTION_MODEL=

# Judge LLM for evaluation (optional, defaults to main LLM config)
JUDGE_LLM_MODEL=
JUDGE_LLM_API_BASE=
JUDGE_LLM_API_KEY=

# JSON logs for logger name `app.*`
OBSERVABILITY_JSON_LOGS=true

# ----- Public API guardrails -----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_PATHS=/chat,/upload
API_AUTH_ENABLED=false
API_KEYS=
API_AUTH_EXEMPT_PATHS=/health,/docs,/openapi.json,/redoc

# ----- Data paths -----
DATA_DIR=./data
PDF_DIR=./data/pdfs
METADATA_JSON=./data/metadata_filtered.json

# ----- API server -----
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
